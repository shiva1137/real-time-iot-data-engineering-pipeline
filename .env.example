# ============================================
# IoT Data Engineering Project - Environment Variables
# ============================================
# Copy to .env and set values. DO NOT commit .env.

# MongoDB
MONGO_URI=mongodb://admin:password@localhost:27017/
MONGO_DATABASE=iot_data
MONGODB_URI=mongodb://admin:password@localhost:27017/iot_data
MONGODB_DATABASE=iot_data

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=iot_analytics
POSTGRES_DATABASE=iot_analytics
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_URI=postgresql://postgres:postgres@localhost:5432/iot_analytics

# Kafka (validation consumer: KAFKA_INPUT_TOPIC=raw_iot_data; streaming job: KAFKA_INPUT_TOPIC=validated_iot_data)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_INPUT_TOPIC=raw_iot_data
KAFKA_OUTPUT_TOPIC=validated_iot_data
KAFKA_DLQ_TOPIC=dlq_iot_data

# Spark Streaming (set KAFKA_INPUT_TOPIC=validated_iot_data when running streaming_job.py)
MONGO_COLLECTION=real_time_aggregates
CHECKPOINT_LOCATION=/tmp/spark_streaming_checkpoint

# API
API_HOST=0.0.0.0
API_PORT=8000

# Logging
LOG_LEVEL=INFO
LOG_FILE=

# ============================================
# AWS (optional - for AWS Data Engineer deployment)
# ============================================
# Set USE_AWS=1 and these when deploying to AWS. Leave blank for local Docker.

# USE_AWS=0
# AWS_REGION=ap-south-1

# S3 data lake (raw landing, processed, checkpoints)
# S3_BUCKET_RAW=s3://your-bucket/iot/raw/
# S3_BUCKET_PROCESSED=s3://your-bucket/iot/processed/
# S3_CHECKPOINT_LOCATION=s3://your-bucket/iot/checkpoints/streaming/

# Amazon MSK (Kafka) - use bootstrap servers from MSK console
# KAFKA_BOOTSTRAP_SERVERS=b-1.xxx.kafka.ap-south-1.amazonaws.com:9092,b-2.xxx.kafka.ap-south-1.amazonaws.com:9092

# Amazon RDS PostgreSQL (same env names: POSTGRES_HOST, POSTGRES_USER, etc.)
# POSTGRES_HOST=your-rds-endpoint.region.rds.amazonaws.com
# POSTGRES_PORT=5432
# POSTGRES_DB=iot_analytics
# POSTGRES_USER=admin
# POSTGRES_PASSWORD=your-secret

# Amazon DocumentDB (MongoDB-compatible) - replace MONGO_URI when using AWS
# MONGO_URI=mongodb://user:pass@docdb-cluster.region.docdb.amazonaws.com:27017/?tls=true

# AWS Glue / EMR (Spark jobs use S3 paths and RDS/DocumentDB via env above)
# GLUE_JOB_NAME=iot-batch-job
# EMR_CLUSTER_ID=j-XXXXXXXXXXXXX

# dbt on AWS: use target rds (RDS) or redshift (Redshift)
# REDSHIFT_HOST=your-cluster.region.redshift.amazonaws.com
# REDSHIFT_PORT=5439
# REDSHIFT_USER=admin
# REDSHIFT_PASSWORD=your-secret
# REDSHIFT_DATABASE=iot_analytics
